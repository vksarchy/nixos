#!/usr/bin/env bash
# Connect Marshall Woburn II and make it the default PipeWire sink.
set -eu

ADDR="${WOBURN_BT_ADDR:-54:B7:E5:83:A0:E2}"
NAME="WOBURN II"
TIMEOUT="${WOBURN_CONNECT_TIMEOUT:-25}"

export PATH="/run/current-system/sw/bin:${PATH:-}"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -t 2500 "Woburn II" "$1" 2>/dev/null || true
  fi
  printf '%s\n' "$1"
}

die() {
  notify "$1"
  exit "${2:-1}"
}

command -v bluetoothctl >/dev/null || die "missing bluetoothctl"
command -v wpctl >/dev/null || die "missing wpctl"

if ! bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
  bluetoothctl power on >/dev/null || true
  sleep 0.5
fi

device_info() {
  bluetoothctl info "$ADDR" 2>/dev/null || true
}

# Any ACL link (LE or BR/EDR). bluetoothctl reports Connected: yes for LE-only too.
is_linked() {
  device_info | grep -q 'Connected: yes'
}

# A2DP needs classic BR/EDR. LE-only links show Connected: yes but never create a sink.
is_bredr_connected() {
  device_info | grep -q 'BREDR.Connected: yes'
}

prefer_bredr() {
  # Prefer classic on next connect (needs bluez Device1 PreferredBearer).
  local path
  path="/org/bluez/hci0/dev_${ADDR//:/_}"
  busctl set-property org.bluez "$path" org.bluez.Device1 PreferredBearer s bredr \
    >/dev/null 2>&1 || true
}

bt_disconnect() {
  bluetoothctl disconnect "$ADDR" >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 25); do
    is_linked || return 0
    sleep 0.2
  done
}

bt_connect() {
  # Returns 0 if linked after attempt (caller still checks BR/EDR + sink).
  if bluetoothctl connect "$ADDR" 2>/dev/null | grep -q 'Connection successful'; then
    return 0
  fi
  # Some bluez builds differ on the success string; trust state.
  is_linked
}

find_sink_id() {
  # Print numeric id of the WOBURN II sink, or empty.
  local block id
  block="$(wpctl status 2>/dev/null | sed -n '/Sinks:/,/Sources:/p' || true)"
  id="$(printf '%s\n' "$block" | grep -i "$NAME" | head -n1 | sed -n 's/^[^0-9]*\*\?[[:space:]]*\([0-9][0-9]*\)\..*/\1/p' || true)"
  printf '%s' "$id"
}

wait_for_sink() {
  local deadline sink_id
  deadline=$((SECONDS + TIMEOUT))
  sink_id=""
  while (( SECONDS < deadline )); do
    if is_bredr_connected; then
      sink_id="$(find_sink_id)"
      if [[ -n "$sink_id" ]]; then
        printf '%s' "$sink_id"
        return 0
      fi
    fi
    sleep 0.4
  done
  printf '%s' "$(find_sink_id)"
  return 1
}

ensure_bredr_link() {
  prefer_bredr

  # Already classic-linked — good.
  if is_bredr_connected; then
    return 0
  fi

  # LE-only (or half-open): drop and reconnect so bluez brings up BR/EDR for A2DP.
  if is_linked; then
    notify "LE-only link — reconnecting for A2DP…"
    bt_disconnect
    sleep 1
  else
    notify "Connecting to $NAME…"
  fi

  if ! bt_connect; then
    bt_disconnect
    sleep 1.5
    bt_connect || true
  fi

  # Brief wait for BREDR flag after dual-mode connect.
  local i
  for i in $(seq 1 20); do
    is_bredr_connected && return 0
    sleep 0.25
  done

  # Still no classic: hard retry once more.
  if ! is_bredr_connected; then
    notify "No BR/EDR yet — retrying…"
    bt_disconnect
    sleep 1.5
    prefer_bredr
    bt_connect || true
    for i in $(seq 1 20); do
      is_bredr_connected && return 0
      sleep 0.25
    done
  fi

  is_bredr_connected
}

ensure_bredr_link || {
  if is_linked; then
    die "Linked (LE only) — A2DP needs classic BR/EDR. Power-cycle speaker?" 2
  fi
  die "Connect failed — speaker on, LED steady (not pairing mode)?" 1
}

sink_id="$(wait_for_sink || true)"

# A2DP profile sometimes fails first connect with "Protocol not available"; one
# more classic reconnect usually brings the PipeWire sink up.
if [[ -z "$sink_id" ]]; then
  notify "No A2DP sink yet — reconnecting…"
  bt_disconnect
  sleep 1.5
  prefer_bredr
  bt_connect || true
  sink_id="$(wait_for_sink || true)"
fi

if [[ -z "$sink_id" ]]; then
  if is_bredr_connected; then
    die "BR/EDR up but no A2DP sink — check WirePlumber bluez roles / bluetoothd log" 2
  fi
  if is_linked; then
    die "Linked (LE only) — A2DP needs classic BR/EDR. Power-cycle speaker?" 2
  fi
  die "Not connected to $NAME" 1
fi

wpctl set-default "$sink_id" >/dev/null
wpctl set-mute "$sink_id" 0 >/dev/null 2>&1 || true
# Refresh Noctalia volume widget/OSD (avoids "no default output" after sink switch)
if command -v noctalia >/dev/null 2>&1; then
  noctalia msg volume-osd >/dev/null 2>&1 || true
fi

codec="$(wpctl inspect "$sink_id" 2>/dev/null | sed -n 's/.*api.bluez5.codec = "\([^"]*\)".*/\1/p' | head -n1 || true)"
codec="${codec:-unknown}"
vol="$(wpctl get-volume "$sink_id" 2>/dev/null | awk '{print $2}' || true)"

notify "Default output · codec ${codec} · vol ${vol:-?}"
exit 0
